diff --git a/object_test.go b/object_test.go
index 2f676b6..84bd4e0 100644
--- a/object_test.go
+++ b/object_test.go
@@ -975,3 +975,28 @@ func TestObjectDeleteReceiver(t *testing.T) {
 	case <-time.After(time.Second):
 	}
 }
+
+// Replacing an object keeps its children by copying the children map, not
+// the struct holding its lock: a lock held at the time of the copy left the
+// new object's lock held and its next update hung.
+func TestMultiWriterValueCopyFromDoesNotCopyLock(t *testing.T) {
+	var old multiWriterValue
+	old.value.Store(map[string]*Object{"child": nil})
+	old.writelk.Lock()
+	defer old.writelk.Unlock()
+	var n multiWriterValue
+	n.copyFrom(&old)
+	done := make(chan struct{})
+	go func() {
+		n.Update(func(v interface{}) interface{} { return v })
+		close(done)
+	}()
+	select {
+	case <-done:
+	case <-time.After(5 * time.Second):
+		t.Fatal("an update of the copy hung: the lock was copied")
+	}
+	if _, ok := n.Load().(map[string]*Object)["child"]; !ok {
+		t.Error("the children were not copied")
+	}
+}
