Description: go vet: do not copy a lock; keyed struct fields
 Replacing an object that has children copied its multiWriterValue, an
 atomic.Value and a sync.Mutex, by value ("assignment copies lock
 value"): a copy made while the lock was held started out locked and its
 next update hung. copyFrom takes the current value instead, with a test.
 The introspect.Arg literals use keyed fields.
Author: NuDanOS Maintainers <jon@fernandez.tech>
Forwarded: no
Last-Update: 2026-10-11
---
diff --git a/dbus.go b/dbus.go
index 7ce7818..749f36c 100644
--- a/dbus.go
+++ b/dbus.go
@@ -137,6 +137,15 @@ func (value *multiWriterValue) Load() interface{} {
 	return value.value.Load()
 }
 
+// copyFrom takes other's current value. The struct itself must not be
+// copied: it holds a lock, and a copy made while the lock was held would
+// start out locked.
+func (value *multiWriterValue) copyFrom(other *multiWriterValue) {
+	if v := other.Load(); v != nil {
+		value.value.Store(v)
+	}
+}
+
 func (value *multiWriterValue) Update(fn func(interface{}) interface{}) {
 	value.writelk.Lock()
 	value.value.Store(fn(value.value.Load()))
