Description: staticcheck findings
 Range loops without a blank value (S1005); one error string lowercased
 (ST1005); godbus's deprecated SessionBusPrivateHandler and
 SystemBusPrivateHandler replaced by local functions written the way godbus
 5.1 implements them (SA1019), so behaviour is unchanged.
Author: NuDanOS Maintainers <jon@fernandez.tech>
Forwarded: no
Last-Update: 2026-10-19
---
--- a/dbus.go
+++ b/dbus.go
@@ -68,20 +68,31 @@ func NewBusManager(
 	return handler, nil
 }
 
+// sessionBusPrivateHandler and systemBusPrivateHandler replace godbus's
+// deprecated SessionBusPrivateHandler and SystemBusPrivateHandler, written
+// the way godbus 5.1 implements them.
+func sessionBusPrivateHandler(handler dbus.Handler, signalHandler dbus.SignalHandler) (*dbus.Conn, error) {
+	return dbus.SessionBusPrivate(dbus.WithHandler(handler), dbus.WithSignalHandler(signalHandler))
+}
+
+func systemBusPrivateHandler(handler dbus.Handler, signalHandler dbus.SignalHandler) (*dbus.Conn, error) {
+	return dbus.SystemBusPrivate(dbus.WithHandler(handler), dbus.WithSignalHandler(signalHandler))
+}
+
 func NewSessionBusManager(name string) (*BusManager, error) {
-	return NewBusManager(dbus.SessionBusPrivateHandler, name)
+	return NewBusManager(sessionBusPrivateHandler, name)
 }
 
 func NewAnonymousSessionBusManager() (*BusManager, error) {
-	return NewAnonymousBusManager(dbus.SessionBusPrivateHandler)
+	return NewAnonymousBusManager(sessionBusPrivateHandler)
 }
 
 func NewSystemBusManager(name string) (*BusManager, error) {
-	return NewBusManager(dbus.SystemBusPrivateHandler, name)
+	return NewBusManager(systemBusPrivateHandler, name)
 }
 
 func NewAnonymousSystemBusManager() (*BusManager, error) {
-	return NewAnonymousBusManager(dbus.SystemBusPrivateHandler)
+	return NewAnonymousBusManager(systemBusPrivateHandler)
 }
 
 func (mgr *BusManager) Conn() *dbus.Conn {
